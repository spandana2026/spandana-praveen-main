{
  "name": "spandana-mern",
  "version": "1.0.0",
  "private": true,
  "type": "module",

  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "postinstall": "npm install --prefix frontend --include=dev && npm run build --prefix frontend",

    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",

    "build": "npm install && npm install --prefix frontend --include=dev && npm run build --prefix frontend",

    "start": "node index.js",

    "diagnose": "node scripts/diagnose.mjs",
    "test:navigation": "node scripts/run-playwright-navigation.mjs",
    "test:navigation:visual": "node scripts/run-playwright-navigation.mjs tests/navigation/visual.spec.ts",
    "test:navigation:controls": "node scripts/run-playwright-navigation.mjs tests/navigation/mobile-designer-controls.spec.ts",
    "test:navigation:live-preview": "node scripts/run-playwright-navigation.mjs tests/navigation/live-page-preview.spec.ts",

    "recovery:status": "node scripts/recovery/recovery-status.mjs",
    "recovery:backup": "node scripts/recovery/backup-system.mjs",
    "recovery:restore": "node scripts/recovery/restore-system.mjs",
    "recovery:console": "node scripts/recovery/recovery-console.mjs",
    "recovery:email-check": "node scripts/recovery/check-email.mjs"
  },

  "devDependencies": {
    "concurrently": "9.1.2",
    "@playwright/test": "1.63.0"
  },

  "dependencies": {
    "adm-zip": "0.5.16",
    "bcrypt": "5.1.1",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "mongoose": "8.13.2",
    "multer": "1.4.5-lts.2",
    "nodemailer": "6.9.16",
    "node-cron": "3.0.3",
    "zod": "3.24.4"
  }
}
