import { useMemo, useState } from 'react';
import { ChevronDown, ChevronUp, Plus, Trash2, ArrowLeft, ArrowRight, Eye, Save } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Textarea } from '@/components/ui/textarea';
import { Switch } from '@/components/ui/switch';
import { Field } from '@/pages/admin/tabs/shared';
import type { FundraisingCampaign } from '@/services/supportTypes';

type AnyRecord = Record<string, any>;
type Props = { campaign: Partial<FundraisingCampaign>; onChange:(next:Partial<FundraisingCampaign>)=>void; onSave:()=>void; onClose:()=>void; busy?:boolean };
type Mode = 'select' | 'fill' | 'preview';

type FieldDef = [string, string, 'input'|'textarea'|'number'|'switch'];

const sectionDefs = [
 {key:'basic',title:'1. Basic Information',description:'Campaign identity and core information.',fields:[
  ['title','Campaign Name','input'],['image','Campaign Poster / Cover Image','input'],['shortDescription','Short Description','textarea'],['geography','Geography','input'],['locationCommunity','Location / Community','input'],['currency','Currency','input'],['startDate','Start Date','input'],['endDate','End Date','input'],['targetAmount','Target Amount','number'],['targetQuantity','Target Quantity','number'],['targetQuantityUnit','Target Quantity Unit','input']
 ] as FieldDef[]},
 {key:'goal',title:'2. Fundraising Goal',description:'Fundraising goal and its purpose.',fields:[['goalDescription','Goal Description','textarea']] as FieldDef[]},
 {key:'needs',title:'3. Needs & Requirements',description:'Add only the needs relevant to this campaign.',items:[['name','Item','input'],['description','Description','textarea'],['category','Category','input'],['quantity','Quantity Needed','number'],['costPerUnit','Cost Per Unit','number']] as FieldDef[]},
 {key:'volunteers',title:'4. Volunteers, Skills & Expertise',description:'Add general volunteer roles or specialist expertise needed.',items:[['role','Role / Skill / Expertise Needed','input'],['numberNeeded','Number Needed','number'],['description','Description','textarea'],['responsibilities','Responsibilities / How They Will Help','textarea'],['skillsExperience','Skills / Experience','textarea'],['eligibility','Eligibility / Qualification','textarea'],['dateTime','Date / Time','input'],['location','Location','input'],['duration','Duration / Commitment','input'],['training','Training / Orientation','textarea'],['expensesSupport','Expenses / Support Provided','textarea'],['registrationRequired','Registration Required','switch'],['registrationLink','Registration Link / Method','input'],['contact','Contact Person / Details','input']] as FieldDef[]},
 {key:'sponsorship',title:'5. Sponsorship Opportunities',description:'Create sponsorship opportunities that supporters can choose.',items:[['title','Sponsorship Opportunity / Name','input'],['description','Description','textarea'],['amount','Sponsorship Amount','number'],['whatItSupports','What It Supports','textarea'],['benefits','Benefits / Recognition','textarea'],['numberNeeded','Number of Sponsorships Available','number'],['allowCustomAmount','Sponsor Can Choose Amount','switch'],['displaySponsorName','Sponsor Name Display','switch'],['contact','Contact / Enquiry Method','input']] as FieldDef[]},
 {key:'inkind',title:'6. In-Kind Support',description:'Request goods, materials, equipment or services without requiring a long form.',items:[['name','What is Needed?','input'],['description','Description','textarea'],['quantity','Quantity Needed','number'],['estimatedValue','Estimated Value','number']] as FieldDef[]},
 {key:'beneficiaries',title:'7. Beneficiaries & Expected Impact',description:'Describe who benefits and what the campaign aims to achieve.',fields:[['whoBenefits','Who Benefits','input'],['numberBeneficiaries','Number of Beneficiaries','number'],['ageGroup','Age Group','input'],['communityLocation','Community / Location','input'],['currentSituation','Current Situation / Need','textarea'],['whatCampaignProvides','What This Campaign Provides','textarea'],['expectedOutcome','Expected Outcome / Impact','textarea'],['indicators','Indicators / Targets','textarea']] as FieldDef[]},
 {key:'team',title:'8. Campaign Team & Contacts',description:'Add the people responsible for the campaign.',items:[['role','Role','input'],['name','Name','input'],['phone','Phone','input'],['email','Email','input'],['whatsapp','WhatsApp','input'],['organisation','Organisation','input'],['notes','Notes','textarea']] as FieldDef[]},
 {key:'logistics',title:'9. Location & Logistics',description:'Detailed operational location and logistics information.',fields:[['venue','Venue','input'],['address','Full Address','textarea'],['area','Community / Area','input'],['cityStateCountry','City / State / Country','input'],['map','Map URL','input'],['serviceArea','Service Area','input'],['distributionCollection','Distribution / Collection Details','textarea'],['transportAccommodation','Transportation / Accommodation','textarea'],['operatingDates','Operating / Service Dates','input'],['instructions','Instructions','textarea']] as FieldDef[]},
 {key:'documents',title:'10. Documents & Attachments',description:'Add proposals, budgets, permissions, reports, photos, videos and other files.',items:[['name','Document / Attachment Name','input'],['type','Type','input'],['url','File / URL','input'],['description','Description','textarea'],['downloadable','Downloadable','switch']] as FieldDef[]},
 {key:'partners',title:'11. Partners & Sponsors',description:'List organisations supporting the campaign.',items:[['name','Name','input'],['type','Type','input'],['logo','Logo URL','input'],['description','Description','textarea'],['website','Website','input'],['supportProvided','Support Provided','textarea'],['recognitionText','Recognition Text','textarea'],['display','Display Publicly','switch']] as FieldDef[]},
 {key:'updates',title:'12. Campaign Updates & Progress',description:'Record campaign milestones and progress updates.',items:[['title','Update Title','input'],['date','Date','input'],['description','Description','textarea'],['progress','Progress','number'],['mediaUrl','Media URL','input'],['documentUrl','Document URL','input']] as FieldDef[]},
 {key:'communication',title:'13. Communication & Thank-You',description:'Set campaign communication and acknowledgement messages.',fields:[['campaignEmail','Campaign Email','input'],['campaignPhone','Campaign Phone','input'],['campaignWhatsApp','Campaign WhatsApp','input'],['website','Website / Link','input'],['socialLinks','Social Links','textarea'],['donorThankYou','Donor Thank-You Message','textarea'],['volunteerThankYou','Volunteer Thank-You Message','textarea'],['inkindThankYou','In-Kind Thank-You Message','textarea'],['sponsorThankYou','Sponsor Thank-You Message','textarea'],['confirmationMessage','Donation Confirmation Message','textarea'],['completionMessage','Campaign Completion Message','textarea']] as FieldDef[]},
 {key:'giving',title:'14. Payment & Giving Options',description:'Choose the types of support this campaign accepts.',fields:[['acceptMoney','Accept Money Donations','switch'],['acceptRequirementSupport','Allow Specific Requirement Support','switch'],['acceptSponsorship','Allow Sponsorship','switch'],['acceptRecurring','Allow Recurring / Monthly','switch'],['acceptInKind','Accept In-Kind Support','switch'],['acceptVolunteers','Accept Volunteers','switch'],['acceptSkills','Accept Skills / Expertise','switch'],['minimumAmount','Minimum Amount','number'],['maximumAmount','Maximum Amount','number'],['allowAnonymous','Allow Anonymous Support','switch']] as FieldDef[]},
 {key:'moreInfo',title:'15. More Information & Enquiries',description:'Give visitors a simple way to ask for more campaign information.',fields:[['whatsappMessage','WhatsApp Enquiry Message','textarea'],['emailMessage','Email Enquiry Message','textarea'],['moreInfoTitle','More Information Window Title','input'],['moreInfoMessage','More Information Window Message','textarea'],['moreInfoForm','Information Requested From Visitor','textarea']] as FieldDef[]},
 {key:'controls',title:'16. Visibility, Publishing & Campaign Controls',description:'Final publication and visitor-facing controls. Public/private decisions happen here, after the campaign is filled.',fields:[['showWebsite','Show on Website','switch'],['allowDonations','Allow Donations','switch'],['featured','Featured Campaign','switch'],['allowPublicUpdates','Allow Public Updates','switch'],['showRequirementSupport','Show Requirement Support','switch'],['showSponsorship','Show Sponsorship','switch'],['showInKind','Show In-Kind Support','switch'],['showVolunteers','Show Volunteer Opportunities','switch'],['showSkills','Show Skills Opportunities','switch'],['showProgress','Show Progress','switch'],['showDonorCount','Show Donor Count','switch'],['allowPublicSharing','Allow Public Sharing','switch'],['directUrlEnabled','Enable Direct Campaign URL','switch'],['displayOrder','Display Order on Campaigns Page','number']] as FieldDef[]},
];

const nice=(s:string)=>s.replace(/([A-Z])/g,' $1').replace(/^./,x=>x.toUpperCase());
const switchKeys=new Set(['registrationRequired','allowCustomAmount','displaySponsorName','downloadable','display','acceptMoney','acceptRequirementSupport','acceptSponsorship','acceptRecurring','acceptInKind','acceptVolunteers','acceptSkills','allowAnonymous','showWebsite','allowDonations','featured','allowPublicUpdates','showRequirementSupport','showSponsorship','showInKind','showVolunteers','showSkills','showProgress','showDonorCount','allowPublicSharing','directUrlEnabled']);
const typeOf=(k:string,t?:string)=>t || (switchKeys.has(k)?'switch':['numberNeeded','quantity','costPerUnit','amount','numberBeneficiaries','estimatedValue','progress','minimumAmount','maximumAmount','displayOrder','targetAmount','targetQuantity'].includes(k)?'number':['description','responsibilities','skillsExperience','eligibility','training','expensesSupport','benefits','whatItSupports','socialLinks','donorThankYou','volunteerThankYou','inkindThankYou','sponsorThankYou','confirmationMessage','completionMessage','whatsappMessage','emailMessage','moreInfoMessage','moreInfoForm','currentSituation','whatCampaignProvides','expectedOutcome','indicators','distributionCollection','transportAccommodation','instructions','notes'].includes(k)?'textarea':'input');

function defaultDetails():AnyRecord{return {sections:{},needs:[],volunteers:[],skills:[],sponsorship:[],inkind:[],beneficiaries:[],team:[],logistics:[],documents:[],partners:[],updates:[],moreInfo:{}}}
function normalizeDetails(raw:any):AnyRecord{const d={...defaultDetails(),...(raw||{})};d.sections={...(raw?.sections||{})};for(const k of ['needs','volunteers','skills','sponsorship','inkind','team','documents','partners','updates'])d[k]=Array.isArray(raw?.[k])?raw[k]:[];return d;}

function labelFor(field:FieldDef){return field[1]}

export default function CampaignBuilder({campaign,onChange,onSave,onClose,busy}:Props){
 const [mode,setMode]=useState<Mode>('select');
 const [open,setOpen]=useState<string>('basic');
 const details=useMemo(()=>normalizeDetails((campaign as AnyRecord).campaignDetails),[campaign]);
 // Older campaign records stored repeatable-section data without selectedFields. Treat fields
 // already present in those records as selected so existing data is never hidden by the new UI.
 const legacySelected=(key:string,fields:FieldDef[])=>{const selected=details.sections[key]?.selectedFields;if(Array.isArray(selected)) return selected;const rows=details[key];if(!Array.isArray(rows)||rows.length===0) return [];return fields.filter(([k])=>rows.some((row:any)=>row?.[k]!==undefined&&row?.[k]!==''&&row?.[k]!==null)).map(f=>f[0]);};
 const update=(patch:AnyRecord)=>onChange({...campaign,campaignDetails:{...details,...patch}} as Partial<FundraisingCampaign>);
 const setSection=(key:string,patch:AnyRecord)=>update({sections:{...details.sections,[key]:{...(details.sections[key]||{}),...patch}}});
 const isSelected=(key:string,field:string)=>details.sections[key]?.selectedFields?.includes(field) || (!Array.isArray(details.sections[key]?.selectedFields) && sectionDefs.find(d=>d.key===key)?.items?.some((f:FieldDef)=>f[0]===field) && legacySelected(key,(sectionDefs.find(d=>d.key===key)?.items||[]) as FieldDef[]).includes(field));
 const toggleField=(key:string,field:FieldDef)=>{
  const def=sectionDefs.find(d=>d.key===key);
  const existing=Array.isArray(details.sections[key]?.selectedFields)?details.sections[key]?.selectedFields:legacySelected(key,((def?.items||[]) as FieldDef[]));
  const selected=new Set(existing||[]);
  if(selected.has(field[0])) selected.delete(field[0]); else selected.add(field[0]);
  setSection(key,{selectedFields:Array.from(selected)});
 };
 const selectedFields=(key:string,fields:FieldDef[])=>fields.filter(f=>isSelected(key,f[0]));
 const setTop=(key:string,val:any)=>onChange({...campaign,[key]:val} as Partial<FundraisingCampaign>);
 const scalarValue=(section:string,key:string)=>section==='basic' ? (campaign as AnyRecord)[key] ?? details.sections.basic?.[key] ?? '' : details.sections[section]?.[key] ?? '';
 const setScalar=(section:string,key:string,val:any)=>section==='basic'?setTop(key,val):setSection(section,{[key]:val});
 const addItem=(section:string,fields:FieldDef[])=>{const item:AnyRecord={};fields.forEach(([k,,t])=>item[k]=t==='switch'?true:'');update({[section]:[...(details[section]||[]),item]});};
 const editItem=(section:string,index:number,key:string,val:any)=>{const arr=[...(details[section]||[])];arr[index]={...arr[index],[key]:val};update({[section]:arr});};
 const removeItem=(section:string,index:number)=>update({[section]:(details[section]||[]).filter((_:any,i:number)=>i!==index)});
 const itemSelectedFields=(section:string,fields:FieldDef[])=>{
  const selected=details.sections[section]?.selectedFields;
  if(Array.isArray(selected)) return fields.filter(f=>selected.includes(f[0]));
  return fields.filter(f=>legacySelected(section,fields).includes(f[0]));
};
  const canBuild = true;
 const selectedCount=sectionDefs.reduce((n,d)=>n+(d.fields?selectedFields(d.key,d.fields).length:0)+(d.items?itemSelectedFields(d.key,d.items).length:0),0);

 const renderField=(section:string,f:FieldDef)=>{const [k,l,t,req]=f;const actual=typeOf(k,t);const val=scalarValue(section,k);if(actual==='switch')return <label key={k} className="flex items-center gap-2 text-sm border rounded-xl p-3"><Switch checked={val!==false} onCheckedChange={v=>setScalar(section,k,v)}/>{labelFor(f)}</label>;return <Field key={k} label={labelFor(f)}>{actual==='textarea'?<Textarea value={val??''} onChange={e=>setScalar(section,k,e.target.value)}/>:<Input type={actual==='number'?'number':'text'} value={val??''} onChange={e=>setScalar(section,k,actual==='number'?(e.target.value?Number(e.target.value):''):e.target.value)}/>}</Field>};

 const renderSelection=(def:any)=>{const isOpen=open===def.key;const fields=(def.fields||[]) as FieldDef[];const items=(def.items||[]) as FieldDef[];const available=fields.length?fields:items;const selected=fields.length?selectedFields(def.key,fields):itemSelectedFields(def.key,items);return <div key={def.key} className="border rounded-2xl overflow-hidden bg-background"><button type="button" className="w-full p-4 flex items-center justify-between text-left" onClick={()=>setOpen(isOpen?'':def.key)}><span><b>{def.title}</b><span className="block text-xs text-muted-foreground mt-1">{def.description}</span><span className="block text-[11px] mt-2 text-muted-foreground">{available.length?`${selected.length} of ${available.length} information fields selected`: 'Available after selection'}</span></span>{isOpen?<ChevronUp size={17}/>:<ChevronDown size={17}/>}</button>{isOpen&&<div className="border-t p-4 space-y-4"><p className="text-xs text-muted-foreground">Select only the information you want to capture for this campaign. Nothing becomes public just because you select it.</p>{available.length>0&&<div className="grid md:grid-cols-2 gap-2">{available.map(f=><label key={f[0]} className={`flex items-center gap-3 rounded-xl border p-3 cursor-pointer ${isSelected(def.key,f[0])?'border-primary bg-primary/5':''}`}><input type="checkbox" checked={isSelected(def.key,f[0])} onChange={()=>toggleField(def.key,f)}/><span className="text-sm">{labelFor(f)}{f[3]==='conditional'?' (conditional)':''}</span></label>)}</div>}{items.length>0&&<p className="text-xs text-muted-foreground">These fields will appear in Fill Campaign. Add Entry is only for additional entries; it is never required to continue.</p>}</div>}</div>};

 const renderFill=(def:any)=>{const fields=(def.fields||[]) as FieldDef[];const chosen=selectedFields(def.key,fields);const itemDefs=(def.items||[]) as FieldDef[];const chosenItems=itemSelectedFields(def.key,itemDefs);const hasSelection=chosen.length>0||chosenItems.length>0;return <div key={def.key} className="border rounded-2xl overflow-hidden bg-background"><button type="button" className="w-full p-4 flex items-center justify-between text-left" onClick={()=>setOpen(open===def.key?'':def.key)}><span><b>{def.title}</b><span className="block text-xs text-muted-foreground mt-1">{def.description}</span></span>{open===def.key?<ChevronUp size={17}/>:<ChevronDown size={17}/>}</button>{open===def.key&&<div className="border-t p-4 space-y-4">{chosen.length>0&&<div className="grid md:grid-cols-2 gap-3">{chosen.map(f=>renderField(def.key,f))}</div>}{def.key==='goal'&&<div className="rounded-xl border p-3 text-xs text-muted-foreground">Amount Raised, Amount Remaining, Goal %, and donor count are calculated automatically from confirmed transactions.</div>}{def.items&&hasSelection&&<div className="space-y-3"><div className="flex justify-between items-center"><p className="text-sm font-semibold">Entries ({details[def.key]?.length||0})</p><Button size="sm" variant="outline" className="rounded-full gap-1" onClick={()=>addItem(def.key,def.items)}><Plus size={13}/>Add Entry</Button></div>{(details[def.key]||[]).map((item:any,i:number)=><div key={i} className="border rounded-xl p-3 space-y-3"><div className="flex justify-between"><b className="text-xs uppercase tracking-wider">Entry {i+1}</b><button type="button" onClick={()=>removeItem(def.key,i)}><Trash2 size={14}/></button></div><div className="grid md:grid-cols-2 gap-3">{chosenItems.map(f=>{const [k,l,t]=f;const actual=typeOf(k,t);if(actual==='switch')return <label key={k} className="flex items-center gap-2 text-sm border rounded-lg p-2"><Switch checked={item[k]!==false} onCheckedChange={v=>editItem(def.key,i,k,v)}/>{labelFor(f)}</label>;return <Field key={k} label={labelFor(f)}>{actual==='textarea'?<Textarea value={item[k]??''} onChange={e=>editItem(def.key,i,k,e.target.value)}/>:<Input type={actual==='number'?'number':'text'} value={item[k]??''} onChange={e=>editItem(def.key,i,k,actual==='number'?(e.target.value?Number(e.target.value):''):e.target.value)}/>}</Field>})}</div></div>)}</div>}{def.items&&!hasSelection&&<p className="text-sm text-muted-foreground">No information fields selected yet. Go back to Select Information.</p>}</div>}</div>};

 const preview=()=>{const basics=(details.sections.basic||{});return <div className="rounded-2xl border bg-background overflow-hidden"><div className="aspect-[16/7] bg-muted flex items-center justify-center overflow-hidden">{campaign.image?<img src={campaign.image as string} alt="Campaign poster" className="w-full h-full object-cover"/>:<span className="text-sm text-muted-foreground">Campaign Poster</span>}</div><div className="p-6 space-y-4"><div><p className="text-2xl font-bold">{campaign.title||'Campaign Title'}</p><p className="text-muted-foreground mt-2">{basics.shortDescription||'Campaign short description will appear here.'}</p></div><div className="grid grid-cols-2 gap-3"><div className="rounded-xl border p-3"><p className="text-xs text-muted-foreground">Target</p><p className="font-semibold">{campaign.targetAmount?`${campaign.currency||'INR'} ${Number(campaign.targetAmount).toLocaleString()}`:'Not set'}</p></div><div className="rounded-xl border p-3"><p className="text-xs text-muted-foreground">Raised</p><p className="font-semibold">Calculated from confirmed donations</p></div></div><div className="flex gap-2"><Button className="rounded-full">Support This Campaign</Button><Button variant="outline" className="rounded-full">Request More Information</Button></div></div></div>};

 return <div className="border rounded-2xl p-4 mb-4 bg-muted/10 space-y-4">
  <div className="flex items-start justify-between gap-3"><div><p className="font-semibold text-lg">{campaign.id?'Edit':'New'} Campaign</p><p className="text-xs text-muted-foreground mt-1">Select → Fill → Preview → Visibility Review → Generate / Publish</p></div><button type="button" onClick={onClose}><Trash2 size={17}/></button></div>
  <div className="flex flex-wrap gap-2"><Button variant={mode==='select'?'default':'outline'} className="rounded-full" onClick={()=>setMode('select')}>1. Select Information</Button><Button variant={mode==='fill'?'default':'outline'} className="rounded-full" onClick={()=>setMode('fill')}>2. Fill Campaign</Button><Button variant={mode==='preview'?'default':'outline'} className="rounded-full gap-1" onClick={()=>setMode('preview')}><Eye size={14}/>3. Preview</Button></div>
  {mode==='select'&&<>
   <div className="rounded-2xl border p-4 bg-background"><p className="font-semibold">Select the information for this campaign</p><p className="text-xs text-muted-foreground mt-1">Click a section to see its available information. Select only what applies. You can add more later.</p><p className="text-xs mt-2">{selectedCount} selected / prepared</p></div>
   {sectionDefs.map(renderSelection)}
   <div className="flex justify-end gap-2 pt-2"><Button type="button" variant="outline" className="rounded-full" onClick={onClose}>Cancel</Button><Button type="button" className="rounded-full gap-1" onClick={(e)=>{e.preventDefault();e.stopPropagation();setMode('fill');setOpen('basic');try{const next={...details};sectionDefs.filter((d:any)=>d.items&&itemSelectedFields(d.key,d.items).length>0).forEach((d:any)=>{if(!Array.isArray(next[d.key])||next[d.key].length===0){next[d.key]=[Object.fromEntries((d.items as FieldDef[]).map((f:any)=>[f[0],f[2]==='switch'?false:'']))]}});update(next)}catch(_e){/* navigation must never be blocked by data preparation */}}}>Build Campaign Form <ArrowRight size={15}/></Button></div>
  </>}
  {mode==='fill'&&<>
   <div className="rounded-2xl border p-4 bg-background"><p className="font-semibold">Fill the selected information</p><p className="text-xs text-muted-foreground mt-1">Only the information you selected is shown here. Nothing is mandatory.</p></div>
   {sectionDefs.map(renderFill)}
   <div className="flex flex-wrap justify-end gap-2 pt-2"><Button variant="outline" className="rounded-full gap-1" onClick={()=>setMode('select')}><ArrowLeft size={15}/>Back to Selection</Button><Button variant="outline" className="rounded-full gap-1" onClick={()=>setMode('preview')}><Eye size={15}/>Preview</Button><Button className="rounded-full gap-1" onClick={onSave} disabled={busy}><Save size={15}/>{busy?'Saving…':'Save Draft'}</Button></div>
  </>}
  {mode==='preview'&&<>
   <div className="rounded-2xl border p-4 bg-background"><p className="font-semibold">Visitor Campaign Preview</p><p className="text-xs text-muted-foreground mt-1">This is intentionally limited. The visitor experience does not expose the full Admin information library.</p></div>
   {preview()}
   <div className="rounded-2xl border p-4 bg-background"><p className="font-semibold">Next: Visibility & Publication Review</p><p className="text-xs text-muted-foreground mt-1">Admin decides what selected information is public or private before publishing. Entering information never makes it public automatically.</p></div>
   <div className="flex flex-wrap justify-end gap-2 pt-2"><Button variant="outline" className="rounded-full gap-1" onClick={()=>setMode('fill')}><ArrowLeft size={15}/>Back to Fill</Button><Button className="rounded-full gap-1" onClick={onSave} disabled={busy}><Save size={15}/>{busy?'Saving…':'Save Campaign'}</Button></div>
  </>}
 </div>
}
