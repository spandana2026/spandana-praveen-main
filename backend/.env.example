# ─────────────────────────────────────────────────────────────────────────
# Spandana Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# The server will NOT start unless ADMIN_PASSWORD and SESSION_SECRET are set.
# ─────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── REQUIRED — server exits with a clear error if these are missing ──────
# Strong admin password — min 12 chars recommended
ADMIN_PASSWORD=change-me-to-a-strong-password

# Random 64-char string: https://generate-secret.vercel.app/64
SESSION_SECRET=replace-with-64-char-random-string

# ── Database (optional — leave blank to use JSON file storage) ───────────
# mongodb+srv://USER:PASS@cluster.mongodb.net/DATABASE_NAME
MONGO_URI=

# ── CORS — origins allowed to call this API ──────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── File Storage ─────────────────────────────────────────────────────────
# Leave blank to use ./data and ./uploads relative to backend folder
DATA_DIR=
UPLOADS_DIR=

# ── Email (optional — contact form and alerts) ────────────────────────────
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
CONTACT_EMAIL=admin@yourdomain.com

# ── Payments (optional — shop checkout) ──────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_SECRET=your_razorpay_secret

# ── Newsletter (optional — admin "Sync to Sheet" button) ──────────────────
# A Google Apps Script "Web App" URL. Leave blank to disable — the admin
# panel's "Download CSV" button works either way. See DEPLOYMENT.md.
GOOGLE_SHEETS_WEBHOOK_URL=

# Admin security / emergency recovery
# This email may be the same address as GMAIL_USER.
ADMIN_RECOVERY_EMAIL=
ADMIN_RECOVERY_MOBILE=
MOBILE_OTP_WEBHOOK_URL=

# Development only: prints OTP delivery failures to console when true; never enable in production
DEV_SHOW_OTP=false

# System recovery / verified recovery points
BACKUP_ROOT=./backups
BACKUP_RETENTION=14
# Optional secondary destination (mount this to durable/off-host storage in production)
BACKUP_EXTERNAL_DIR=
# Emergency Recovery Console — email OTP is the primary recovery authentication method.
# Set this to the dedicated recovery email address. Do not use a public/shared mailbox.
RECOVERY_PORT=5051
BACKUP_INTERVAL_HOURS=24
